# Instagram Graph API Configuration
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

# Notification Configuration (通知設定)
# いずれかの通知方法を設定してください
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
ZAPIER_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxxx/yyyyy/
NOTIFICATION_EMAIL=your-email@example.com

# Dashboard Configuration
DASHBOARD_URL=http://localhost:3000
DASHBOARD_PORT=3000

# Media Storage
MEDIA_DOWNLOAD_PATH=./downloads

# Sync Configuration
SYNC_INTERVAL_MINUTES=30
TIMEZONE=Asia/Tokyo

# Logging
LOG_LEVEL=info

# 注意: Google Business Profile APIは一般ユーザーは使用できません
# このシステムは通知+データ準備アプローチを採用しています
# 詳細は REALISTIC_ALTERNATIVES.md を参照してください

# ========================================
# Enterprise Scale Configuration (100+ locations)
# ========================================

# Automatic posting to GBP (完全自動投稿)
AUTO_POST_TO_GBP=false

# Buffer API Configuration (推奨)
BUFFER_ACCESS_TOKEN=your_buffer_access_token
BUFFER_AUTO_PUBLISH=true  # true = 即座に投稿, false = Bufferキューに追加
INCLUDE_INSTAGRAM_LINK=false  # GBP投稿にInstagramリンクを含める

# Puppeteer Automation (コスト重視、リスクあり)
USE_PUPPETEER=false
GOOGLE_EMAIL=your_google_email@example.com
GOOGLE_PASSWORD=your_google_password

# Multi-location sync settings
LOCATIONS_FILE=./config/locations.json
SYNC_BATCH_SIZE=10  # 一度に処理する店舗数
SYNC_BATCH_DELAY=5000  # バッチ間の待機時間（ミリ秒）
